{"t": 175.19, "step": "state_after_helper_hide", "kind": "call", "tool": "tc_execute_code", "action": "execute_code", "args": {"code": "ИмяГруппы = Параметры[\"group\"];\nДействие = Параметры[\"action\"];\nРезультат = Новый Структура(\"ФормНайдено, Данные\", 0, Неопределено);\nДля Каждого Ок Из ПолучитьОкна() Цикл\n\tДля Каждого Ф Из Ок.Содержимое Цикл\n\t\tЕсли СтрНайти(Ф.ИмяФормы, \"СпайкАРМКС\") = 0 Тогда\n\t\t\tПродолжить;\n\t\tКонецЕсли;\n\t\tГ = Ф.Элементы.Найти(ИмяГруппы);\n\t\tЕсли Г = Неопределено Тогда\n\t\t\tПродолжить;\n\t\tКонецЕсли;\n\t\tРезультат.ФормНайдено = Результат.ФормНайдено + 1;\n\t\tЕсли Действие = \"hide\" Тогда\n\t\t\tГ.Скрыть();\n\t\tИначеЕсли Действие = \"show\" Тогда\n\t\t\tГ.Показать();\n\t\tКонецЕсли;\n\t\tДети = Новый Массив;\n\t\tДля Каждого П Из Г.ПодчиненныеЭлементы Цикл\n\t\t\tДети.Добавить(Новый Структура(\"Имя, Видимость\", П.Имя, П.Видимость));\n\t\tКонецЦикла;\n\t\tРезультат.Данные = Новый Структура(\"Скрыта, Видимость, Поведение, Вид, Дети\", Г.Скрыта(), Г.Видимость, Строка(Г.Поведение), Строка(Г.Вид), Дети);\n\tКонецЦикла;\nКонецЦикла;", "context": "client", "parameters": {"group": "ГруппаСвертываемая", "action": ""}}, "isError": false, "result": {"request_id": "8dd7c49c0db64d14a0455696b8ba162d", "ok": true, "result": {"Данные": {"Дети": [{"Видимость": true, "Имя": "НадписьВГруппе"}], "Вид": "Обычная группа", "Поведение": "Свертываемая", "Видимость": true, "Скрыта": true}, "ФормНайдено": 1}, "connection_id": "cb6989a815f664409"}, "dt": 0.03}
