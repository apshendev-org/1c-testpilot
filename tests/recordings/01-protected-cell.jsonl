{"t": 160.54, "step": "helper", "kind": "call", "tool": "tc_execute_code", "action": "execute_code", "args": {"code": "ИмяЭлемента = Параметры[\"element\"];\nПутьДанных = Параметры[\"data\"];\nРезультат = Новый Структура(\"ФормНайдено, Данные\", 0, Неопределено);\nДля Каждого Ок Из ПолучитьОкна() Цикл\n\tДля Каждого Ф Из Ок.Содержимое Цикл\n\t\tЕсли СтрНайти(Ф.ИмяФормы, \"СпайкАРМКС\") = 0 Тогда\n\t\t\tПродолжить;\n\t\tКонецЕсли;\n\t\tЭл = Ф.Элементы.Найти(ИмяЭлемента);\n\t\tЕсли Эл = Неопределено Тогда\n\t\t\tПродолжить;\n\t\tКонецЕсли;\n\t\tРезультат.ФормНайдено = Результат.ФормНайдено + 1;\n\t\tПопытка\n\t\t\tПутьКДанным = Строка(Эл.ПутьКДанным);\n\t\tИсключение\n\t\t\tПутьКДанным = \"Недоступно: \" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());\n\t\tКонецПопытки;\n\t\tПопытка\n\t\t\tТолькоПросмотр = Эл.ТолькоПросмотр;\n\t\tИсключение\n\t\t\tТолькоПросмотр = \"Недоступно: \" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());\n\t\tКонецПопытки;\n\t\tЕсли ПутьДанных = \"\" Тогда\n\t\t\tПутьДанных = ИмяЭлемента;\n\t\tКонецЕсли;\n\t\tСпособ = \"\";\n\t\tОш = \"\";\n\t\tДок = Неопределено;\n\t\tПопытка\n\t\t\tДок = Вычислить(\"Ф.\" + ПутьДанных);\n\t\t\tСпособ = \"Вычислить(Ф.\" + ПутьДанных + \")\";\n\t\tИсключение\n\t\t\tОш = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());\n\t\tКонецПопытки;\n\t\tЕсли Док = Неопределено Тогда\n\t\t\tРезультат.Данные = Новый Структура(\"ИмяФормы, ИмяЭлемента, ПутьКДанным, Способ, Ошибка\", Ф.ИмяФормы, ИмяЭлемента, ПутьКДанным, Способ, Ош);\n\t\t\tПродолжить;\n\t\tКонецЕсли;\n\t\tЯчейки = Новый Структура;\n\t\tДля Каждого Адр Из Параметры[\"cells\"] Цикл\n\t\t\tО = Док.Область(Адр);\n\t\t\tСв = Новый Структура(\"Защита, Текст, СодержитЗначение, Видимость, Имя\", О.Защита, О.Текст, О.СодержитЗначение, О.Видимость, О.Имя);\n\t\t\tЕсли О.СодержитЗначение Тогда\n\t\t\t\tСв.Вставить(\"ТипЗначения\", Строка(О.ТипЗначения));\n\t\t\t\tСв.Вставить(\"Значение\", Строка(О.Значение));\n\t\t\tКонецЕсли;\n\t\t\tПопытка\n\t\t\t\tСв.Вставить(\"Расшифровка\", Строка(О.Расшифровка));\n\t\t\tИсключение\n\t\t\t\tСв.Вставить(\"Расшифровка\", \"Недоступно: \" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));\n\t\t\tКонецПопытки;\n\t\t\tЯчейки.Вставить(Адр, Св);\n\t\tКонецЦикла;\n\t\tРезультат.Данные = Новый Структура(\"ИмяФормы, ИмяЭлемента, ВидЭлемента, ПутьКДанным, ТолькоПросмотрЭлемента, Способ, Ошибка, ТипДанных, ЗащитаДокумента, Ячейки\",\n\t\t\tФ.ИмяФормы, ИмяЭлемента, Строка(Эл.Вид), ПутьКДанным, ТолькоПросмотр, Способ, Ош, Строка(ТипЗнч(Док)), Док.Защита, Ячейки);\n\tКонецЦикла;\nКонецЦикла;", "context": "client", "parameters": {"element": "ТаблицаАРМ", "data": "", "cells": ["R2C4", "R2C5"]}}, "isError": false, "result": {"request_id": "54d623a4450f4c6bb1c9434f7f282bcd", "ok": true, "result": {"Данные": {"ЗащитаДокумента": true, "ТипДанных": "Табличный документ", "Ячейки": {"R2C5": {"Расшифровка": "e;0;С2026;5", "Значение": "101", "Имя": "R2C5", "ТипЗначения": "Число", "Видимость": true, "СодержитЗначение": true, "Текст": "101,00", "Защита": false}, "R2C4": {"Расшифровка": "", "Имя": "R2C4", "Видимость": true, "СодержитЗначение": false, "Текст": "Бухгалтерия", "Защита": true}}, "Способ": "Вычислить(Ф.ТаблицаАРМ)", "ТолькоПросмотрЭлемента": false, "Ошибка": "", "ВидЭлемента": "Поле табличного документа", "ПутьКДанным": "Недоступно: Свойство недоступно", "ИмяЭлемента": "ТаблицаАРМ", "ИмяФормы": "ВнешняяОбработка.СпайкАРМКС.Форма.Форма"}, "ФормНайдено": 1}, "connection_id": "c61e5f4d1317a45ed"}, "dt": 0.04}
